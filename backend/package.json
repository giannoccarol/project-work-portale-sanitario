{
  "name": "puglia-salute-backend",
  "version": "1.0.0",
  "description": "Backend API RESTful di Puglia Salute per la rete sanitaria pugliese (PW16 - CdS Informatica per le Aziende Digitali)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && concurrently -k -n TYPESCRIPT,API \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "npm run build && cross-env NODE_ENV=seed DB_SYNCHRONIZE=true node dist/seed/seed.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/config/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/config/data-source.js",
    "test": "jest --runInBand --forceExit",
    "contract:test": "jest --runInBand src/config/swagger.spec.ts",
    "swagger:gen": "echo 'Swagger e servito a runtime su /api-docs'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
